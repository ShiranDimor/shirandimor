// NQ / MNQ Daily Levels: 50% Daily Range + Asia High/Low + London High/Low + Previous Day High/Low + Previous Day POC/VAH/VAL + Volume Profile histogram
//
// כל השעות מחושבות לפי America/New_York (כולל שעון קיץ/חורף), בלי קשר לאזור הזמן של הגרף.
// החישוב רץ על נתוני דקה (request.security "1") ולא על הנרות שבגרף. לכן:
//   * הוא כולל את כל המסחר מתחילת היום, גם מה שמחוץ לחלון הגרף המוצג.
//   * התוצאות זהות בכל טווח זמן (1 דקה, 5 דקות, שעה, 4 שעות, יומי) של אותו חוזה.

//@version=6
indicator("NQ Daily Levels (50% / Asia / London / PDH-PDL / VP)", shorttitle = "NQ Levels", overlay = true, max_lines_count = 60, max_labels_count = 100, max_boxes_count = 500)

const string TZ = "America/New_York"

// ───────────── הגדרות ─────────────
cleanMode = input.bool(false, "מצב נקי - רק קווי הליבה", tooltip = "משאיר רק: 50% Daily Range, Asia High/Low, London High/Low, Previous Day High/Low ו-PD POC. מסתיר את PD VAH/VAL, את קווי Today, את פרופילי הנפח, את קופסאות הסשנים ואת השמות הקטנים על הקווים. ביטול הסימון מחזיר את התצוגה המלאה לפי שאר ההגדרות.", group = "מצב תצוגה")
G_DAY = "יום מסחר (שעון ניו יורק)"
dayStartH = input.int(18, "תחילת יום: שעה", minval = 0, maxval = 23, inline = "ds", group = G_DAY)
dayStartM = input.int(0, "דקה", minval = 0, maxval = 59, inline = "ds", group = G_DAY)

G_MID = "50% Daily Range"
showMid  = input.bool(true, "הצג", group = G_MID)
midColor = input.color(#FFD600, "צבע", inline = "m", group = G_MID)
midWidth = input.int(2, "עובי", minval = 1, maxval = 10, inline = "m", group = G_MID)
midStyle = input.string("Dashed", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "m", group = G_MID)

G_ASIA = "Asia High / Low"
showAsia  = input.bool(true, "הצג", group = G_ASIA)
asiaSess  = input.session("2000-0000", "חלון (שעון ניו יורק)", group = G_ASIA)
asiaColor = input.color(#00BCD4, "צבע", inline = "a", group = G_ASIA)
asiaWidth = input.int(2, "עובי", minval = 1, maxval = 10, inline = "a", group = G_ASIA)
asiaStyle = input.string("Solid", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "a", group = G_ASIA)

G_LON = "London High / Low"
showLon  = input.bool(true, "הצג", group = G_LON)
lonSess  = input.session("0200-0500", "חלון (שעון ניו יורק)", group = G_LON)
lonColor = input.color(#E040FB, "צבע", inline = "l", group = G_LON)
lonWidth = input.int(2, "עובי", minval = 1, maxval = 10, inline = "l", group = G_LON)
lonStyle = input.string("Solid", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "l", group = G_LON)

G_PD = "Previous Day High / Low"
showPD  = input.bool(true, "הצג", group = G_PD)
pdColor = input.color(#FF9800, "צבע", inline = "p", group = G_PD)
pdWidth = input.int(2, "עובי", minval = 1, maxval = 10, inline = "p", group = G_PD)
pdStyle = input.string("Solid", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "p", group = G_PD)

G_VP = "Previous Day Volume Profile (POC / VAH / VAL)"
showVP   = input.bool(true, "הצג", group = G_VP)
vpRow    = input.float(1.0, "גובה שורה בפרופיל (נקודות)", minval = 0.25, step = 0.25, group = G_VP)
vpVA     = input.int(70, "אחוז Value Area", minval = 10, maxval = 100, group = G_VP)
pocColor = input.color(#F44336, "POC: צבע", inline = "vp1", group = G_VP)
pocWidth = input.int(2, "עובי", minval = 1, maxval = 10, inline = "vp1", group = G_VP)
pocStyle = input.string("Solid", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "vp1", group = G_VP)
vaColor  = input.color(#B0BEC5, "VAH / VAL: צבע", inline = "vp2", group = G_VP)
vaWidth  = input.int(2, "עובי", minval = 1, maxval = 10, inline = "vp2", group = G_VP)
vaStyle  = input.string("Dashed", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "vp2", group = G_VP)

G_TD = "Today Volume Profile (POC / VAH / VAL) - מתעדכן"
showTD   = input.bool(true, "הצג", group = G_TD)
tdPocCol = input.color(#FFFFFF, "Today POC: צבע", inline = "td1", group = G_TD)
tdPocW   = input.int(2, "עובי", minval = 1, maxval = 10, inline = "td1", group = G_TD)
tdPocSt  = input.string("Solid", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "td1", group = G_TD)
tdVaCol  = input.color(#00E676, "Today VAH / VAL: צבע", inline = "td2", group = G_TD)
tdVaW    = input.int(1, "עובי", minval = 1, maxval = 10, inline = "td2", group = G_TD)
tdVaSt   = input.string("Dotted", "סגנון", options = ["Solid", "Dashed", "Dotted"], inline = "td2", group = G_TD)

G_SS = "קופסאות סשנים (קופסה מהגבוה לנמוך)"
showSess  = input.bool(true, "הצג סשנים", group = G_SS)
sessDays  = input.int(3, "כמה ימים להציג (כולל היום)", minval = 1, maxval = 10, group = G_SS)
sessAlpha = input.int(85, "שקיפות הקופסאות (0-100)", minval = 0, maxval = 100, group = G_SS)
sessNums  = input.bool(false, "הצג מחירים מעל הקופסאות (H / L / טווח)", group = G_SS)
// קופסאות אסיה ולונדון משתמשות באותם חלונות בדיוק כמו קווי Asia / London High-Low (מההגדרות למעלה),
// כך שהגבוה/נמוך של כל קופסה תמיד יושב על הקווים של אותו סשן
showTok   = input.bool(true, "Asia (לפי החלון של Asia High / Low)", inline = "s1", group = G_SS)
tokColor  = input.color(#00BCD4, "", inline = "s1", group = G_SS)
showLdn   = input.bool(true, "London (לפי החלון של London High / Low)", inline = "s2", group = G_SS)
ldnColor  = input.color(#E040FB, "", inline = "s2", group = G_SS)
showNy    = input.bool(false, "New York (ניו יורק)", inline = "s3", group = G_SS)
nySess    = input.session("0930-1600", "שעון ניו יורק", inline = "s3", group = G_SS)
nyColor   = input.color(#FF9800, "", inline = "s3", group = G_SS)

G_VPH = "Volume Profile - היסטוגרמה"
sideProf   = input.string("היום (מתעדכן)", "פרופיל בצד ימין, ליד המחיר", options = ["היום (מתעדכן)", "אתמול", "ללא"], tooltip = "המקובל: הפרופיל של היום בצד, והרמות של אתמול כקווים (PD POC / VAH / VAL)", group = G_VPH)
histOffset = input.int(16, "מיקום הפרופיל בצד ימין (בנרות מהנר האחרון)", minval = 2, maxval = 500, tooltip = "הקצה הימני של הפרופיל - כמה נרות ימינה מהנר האחרון. כך הפרופיל יושב בשטח הריק ליד סקאלת המחירים ולא על הנרות. אם הוא נחתך בצד ימין - להקטין; אם הוא רחוק מסקאלת המחירים - להגדיל", group = G_VPH)
histBars   = input.int(8, "רוחב הפרופיל בצד ימין (בנרות)", minval = 3, maxval = 300, tooltip = "אורך השורה הארוכה ביותר (ה-POC). מספר קטן = פרופיל דק", group = G_VPH)
showHistPD = input.bool(false, "הצג גם את הפרופיל של אתמול על האזור של אתמול בגרף", group = G_VPH)
showHistCD = input.bool(false, "הצג גם את הפרופיל של היום על האזור של היום בגרף", group = G_VPH)
histRows   = input.int(120, "מספר שורות בהיסטוגרמה", minval = 20, maxval = 200, group = G_VPH)
histWidth  = input.int(30, "רוחב מקסימלי לפרופיל על אזור היום (% מאורך היום)", minval = 5, maxval = 100, group = G_VPH)
histVA     = input.color(color.new(#787B86, 65), "צבע Value Area", group = G_VPH)
histOut    = input.color(color.new(#5D606B, 80), "צבע מחוץ ל-Value Area", group = G_VPH)
histPOC    = input.color(color.new(#F44336, 20), "צבע שורת POC (אתמול)", group = G_VPH)
histPOCtd  = input.color(color.new(#FFFFFF, 50), "צבע שורת POC (היום)", group = G_VPH)

G_LBL = "תוויות"
showLabels  = input.bool(true, "הצג תוויות", group = G_LBL)
labelOffset = input.int(3, "מרחק מהנר האחרון (בנרות)", minval = 0, maxval = 300, group = G_LBL)
labelText   = input.color(color.black, "צבע טקסט", group = G_LBL)
labelSize   = input.string("Small", "גודל", options = ["Small", "Normal", "Large"], group = G_LBL)
showTags    = input.bool(true, "הצג את שם הקו גם על הקו עצמו (בתחילתו)", group = G_LBL)
lblGap      = input.float(5, "מרווח מינימלי בין תוויות (נקודות)", minval = 0, step = 1, tooltip = "כשכמה קווים קרובים במחיר, התוויות מימין מוזזות למטה כך שלא יעלו אחת על השנייה. המחיר בתווית תמיד המחיר המדויק של הקו. אם התוויות עדיין עולות זו על זו - להגדיל; אם הן רחוקות מדי מהקווים - להקטין.", group = G_LBL)
showScale   = input.bool(true, "הצג מחירים על סקאלת המחירים", group = G_LBL)

G_ALR = "התראות"
alertAsia  = input.bool(true, "התראה כשהמחיר מגיע ל-Asia High / Low", group = G_ALR)
alertLon   = input.bool(true, "התראה כשהמחיר מגיע ל-London High / Low", group = G_ALR)
alertPD    = input.bool(true, "התראה כשהמחיר מגיע ל-Previous Day High / Low", group = G_ALR)
alertVP    = input.bool(true, "התראה כשהמחיר מגיע ל-POC / VAH / VAL של יום קודם", group = G_ALR)
alertMid   = input.bool(true, "התראה כשהמחיר מגיע ל-50% Daily Range", group = G_ALR)
alertCool  = input.int(15, "אחרי התראה על קו - לא להתריע שוב על אותו קו במשך (דקות)", minval = 0, maxval = 240, tooltip = "כל קו מתריע לכל היותר פעם אחת בפרק הזמן הזה, גם אם המחיר נוגע בו שוב ושוב. 0 = בלי הגבלת זמן", group = G_ALR)
alertRearm = input.float(10, "התראה חוזרת על אותו קו רק אחרי שהמחיר התרחק ממנו (נקודות)", minval = 1, step = 1, tooltip = "מתריע על כל נגיעה בקו, אבל אחרי נגיעה הקו 'נטען' מחדש רק כשהמחיר התרחק ממנו לפחות כמה נקודות. כך לא מקבלים עשרות התראות כשהמחיר מדשדש על הקו. גם קו שרק נוצר (למשל London Low בסגירת החלון) יתריע רק כשהמחיר יתרחק ממנו ויחזור", group = G_ALR)

G_RISK = "טבלת כמות חוזים (סיכון קבוע)"
showRisk = input.bool(true, "הצג טבלה", tooltip = "לכל קו קרוב: אם הסטופ יושב מעבר לקו - כמה חוזים להיכנס כך שההפסד בסטופ לא יעבור את הסיכון שהוגדר. קו מתחת למחיר = סטופ ללונג, קו מעל המחיר = סטופ לשורט. הכמות מעוגלת תמיד למטה. שווי הנקודה נלקח מהחוזה שבגרף (MNQ = $2, NQ = $20)", group = G_RISK)
riskUsd  = input.float(500, "סיכון לעסקה ($)", minval = 1, step = 50, group = G_RISK)
stopBuf  = input.float(2, "מרווח הסטופ מעבר לקו (נקודות)", minval = 0, step = 0.25, tooltip = "הסטופ לא בדיוק על הקו אלא קצת מעבר לו: מתחת לקו בלונג, מעליו בשורט", group = G_RISK)
riskFee  = input.float(0, "עמלה לחוזה הלוך-חזור ($)", minval = 0, step = 0.1, tooltip = "אופציונלי - נכנס לחישוב ההפסד לחוזה", group = G_RISK)
riskRows = input.int(3, "כמה קווים להציג מכל צד של המחיר", minval = 1, maxval = 8, group = G_RISK)
riskPos  = input.string("למטה משמאל", "מיקום", options = ["למעלה משמאל", "למעלה מימין", "באמצע משמאל", "באמצע מימין", "למטה משמאל", "למטה מימין"], group = G_RISK)
riskSize = input.string("Normal", "גודל טקסט", options = ["Small", "Normal", "Large"], group = G_RISK)

// במצב נקי מכבים כל מה שאינו קו ליבה (ההגדרות עצמן נשמרות וחוזרות כשמבטלים את המצב הנקי)
showTD     := showTD and not cleanMode
showHistPD := showHistPD and not cleanMode
showHistCD := showHistCD and not cleanMode
sideProf   := cleanMode ? "ללא" : sideProf
showSess   := showSess and not cleanMode
showTags   := showTags and not cleanMode
showPdVa    = showVP and not cleanMode

if timeframe.isweekly or timeframe.ismonthly
    runtime.error("NQ Daily Levels עובד בטווחי זמן של יום ומטה.")

// ───────────── עזרים ─────────────
// "HHMM-HHMM" -> [דקת התחלה, דקת סיום] ביום (0-1439)
f_parse(string s) =>
    sh = str.tonumber(str.substring(s, 0, 2))
    sm = str.tonumber(str.substring(s, 2, 4))
    eh = str.tonumber(str.substring(s, 5, 7))
    em = str.tonumber(str.substring(s, 7, 9))
    [int(sh * 60 + sm), int(eh * 60 + em)]

// האם דקה ביום (m) נמצאת בחלון [s, e). תומך בחלון שעובר חצות.
f_inWin(int m, int s, int e) =>
    s < e ? (m >= s and m < e) : s > e ? (m >= s or m < e) : false

f_style(string s) =>
    switch s
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        => line.style_dashed

// ───────────── מנוע החישוב (רץ על נרות של דקה) ─────────────
// Volume Profile: POC + Value Area מתוך מפה של (מספר שורה -> נפח)
f_profile(map<int, float> vp, int kLo, int kHi, float row, int vaPct) =>
    float poc = na
    float vah = na
    float val = na
    if vp.size() > 0
        float total = 0.0
        float best  = -1.0
        int   kPoc  = kLo
        for k = kLo to kHi
            v = nz(vp.get(k))
            total += v
            if v > best
                best := v
                kPoc := k
        // מרחיבים מה-POC כלפי מעלה/מטה, כל פעם לצד עם יותר נפח, עד שמגיעים לאחוז ה-Value Area
        int   up  = kPoc
        int   dn  = kPoc
        float acc = best
        float target = total * vaPct / 100.0
        while acc < target and (up < kHi or dn > kLo)
            vUp = up < kHi ? nz(vp.get(up + 1)) : -1.0
            vDn = dn > kLo ? nz(vp.get(dn - 1)) : -1.0
            if vUp >= vDn
                up += 1
                acc += vUp
            else
                dn -= 1
                acc += vDn
        poc := math.round_to_mintick((kPoc + 0.5) * row)
        vah := math.round_to_mintick((up + 1) * row)
        val := math.round_to_mintick(dn * row)
    [poc, vah, val]

f_engine(int dsMin, int aS, int aE, int lS, int lE, float row, int vaPct) =>
    m = hour(time, TZ) * 60 + minute(time, TZ)
    // מזיזים את הזמן כך שתחילת יום המסחר נופלת על חצות, ואז התאריך = מזהה יום המסחר
    tShift = time + (1440 - dsMin) * 60000
    key = year(tShift, TZ) * 10000 + month(tShift, TZ) * 100 + dayofmonth(tShift, TZ)
    newDay = bar_index == 0 or key != key[1]

    var float dHi = na
    var float dLo = na
    var int   dT  = na
    var bool  dFull = false
    var float aHi = na
    var float aLo = na
    var int   aT  = na
    var float lHi = na
    var float lLo = na
    var int   lT  = na
    var float pdHi = na
    var float pdLo = na
    var bool  pdFull = false
    var map<int, float> vp = map.new<int, float>()
    var int   kLo = na
    var int   kHi = na
    var float pPoc = na
    var float pVah = na
    var float pVal = na

    if newDay
        // פרופיל הנפח של היום שהסתיים -> POC / VAH / VAL של "יום קודם"
        [poc, vah, val] = f_profile(vp, kLo, kHi, row, vaPct)
        pPoc := bar_index > 0 ? poc : na
        pVah := bar_index > 0 ? vah : na
        pVal := bar_index > 0 ? val : na
        vp.clear()
        kLo := na
        kHi := na
        // היום שהסתיים הופך ל"יום הקודם" (רק אם יש לנו אותו מתחילתו)
        pdHi := bar_index > 0 ? dHi : na
        pdLo := bar_index > 0 ? dLo : na
        pdFull := dFull
        dHi := high
        dLo := low
        dT  := time
        dFull := bar_index > 0   // false = הנתונים התחילו באמצע היום
        aHi := na
        aLo := na
        aT  := na
        lHi := na
        lLo := na
        lT  := na
    else
        dHi := math.max(dHi, high)
        dLo := math.min(dLo, low)

    if f_inWin(m, aS, aE)
        aHi := na(aHi) ? high : math.max(aHi, high)
        aLo := na(aLo) ? low : math.min(aLo, low)
        aT  := na(aT) ? time : aT

    if f_inWin(m, lS, lE)
        lHi := na(lHi) ? high : math.max(lHi, high)
        lLo := na(lLo) ? low : math.min(lLo, low)
        lT  := na(lT) ? time : lT

    // מוסיפים את נפח נר הדקה לפרופיל של היום, מחולק שווה על כל השורות שבין הנמוך לגבוה
    b0 = int(math.floor(low / row))
    b1 = int(math.floor(high / row))
    vShare = nz(volume) / (b1 - b0 + 1)
    for k = b0 to b1
        vp.put(k, nz(vp.get(k)) + vShare)
    kLo := na(kLo) ? b0 : math.min(kLo, b0)
    kHi := na(kHi) ? b1 : math.max(kHi, b1)

    aDone = not na(aT) and not f_inWin(m, aS, aE)   // חלון אסיה הסתיים
    lDone = not na(lT) and not f_inWin(m, lS, lE)   // חלון לונדון הסתיים
    [dHi, dLo, dT, dFull, aHi, aLo, aT, lHi, lLo, lT, aDone, lDone, pdHi, pdLo, pdFull, pPoc, pVah, pVal]

[aS, aE] = f_parse(asiaSess)
[lS, lE] = f_parse(lonSess)
dsMin = dayStartH * 60 + dayStartM

[dHi, dLo, dT, dFull, aHi, aLo, aT, lHi, lLo, lT, aDone, lDone, pdHi, pdLo, pdFull, pPoc, pVah, pVal] = request.security(syminfo.tickerid, "1", f_engine(dsMin, aS, aE, lS, lE, vpRow, vpVA), lookahead = barmerge.lookahead_on)

mid = (dHi + dLo) / 2

// ───────────── היסטוגרמת Volume Profile (יום קודם + היום) ─────────────
// נבנית מנרות של דקה (request.security_lower_tf), לכן הצורה זהה בכל טווח זמן של הגרף.
type Prof
    map<int, float> vol
    int  start
    int  kLo
    int  kHi
    bool full

f_dayKey(int t, int dsMin) =>
    ts = t + (1440 - dsMin) * 60000
    year(ts, TZ) * 10000 + month(ts, TZ) * 100 + dayofmonth(ts, TZ)

f_addBar(Prof p, float h, float l, float v, float row) =>
    b0 = int(math.floor(l / row))
    b1 = int(math.floor(h / row))
    share = nz(v) / (b1 - b0 + 1)
    for k = b0 to b1
        p.vol.put(k, nz(p.vol.get(k)) + share)
    p.kLo := na(p.kLo) ? b0 : math.min(p.kLo, b0)
    p.kHi := na(p.kHi) ? b1 : math.max(p.kHi, b1)

f_copy(Prof p) =>
    Prof r = na
    if not na(p)
        r := Prof.new(p.vol.copy(), p.start, p.kLo, p.kHi, p.full)
    r

// מוסיף נרות דקה לפרופיל של היום; כשמתחיל יום חדש - היום הנוכחי הופך ל"יום קודם"
f_process(Prof c0, Prof p0, int k0, array<int> ts, array<float> hs, array<float> ls, array<float> vs) =>
    Prof c = c0
    Prof p = p0
    int  key0 = k0
    n = ts.size()
    if n > 0
        for i = 0 to n - 1
            t = ts.get(i)
            k = f_dayKey(t, dsMin)
            if na(key0) or k != key0
                p := c
                c := Prof.new(map.new<int, float>(), t, na, na, not na(key0))
                key0 := k
            f_addBar(c, hs.get(i), ls.get(i), vs.get(i), vpRow)
    [c, p, key0]

ltf = timeframe.isseconds ? timeframe.period : "1"
[ltT, ltH, ltL, ltV] = request.security_lower_tf(syminfo.tickerid, ltf, [time, high, low, volume])

var Prof curP   = na
var Prof prevP  = na
var int  curKey = na

// מצב קבוע מתעדכן רק בנרות סגורים; לנר החי עובדים על עותק (כדי לא לספור נפח פעמיים)
Prof drawCur  = na
Prof drawPrev = na
if barstate.isconfirmed
    [c1, p1, k1] = f_process(curP, prevP, curKey, ltT, ltH, ltL, ltV)
    curP   := c1
    prevP  := p1
    curKey := k1
    drawCur  := curP
    drawPrev := prevP
else
    [c2, p2, k2] = f_process(f_copy(curP), prevP, curKey, ltT, ltH, ltL, ltV)
    drawCur  := c2
    drawPrev := p2

// x0 = נקודת העיגון: fromRight=false -> הפסים מתחילים ב-x0 ונמשכים ימינה (רוחב מקסימלי = % מאורך יום);
// fromRight=true -> הפסים נגמרים ב-x0 וגדלים שמאלה, כמו פרופיל שצמוד לסקאלת המחירים (רוחב מקסימלי = histBars נרות)
f_hist(box[] bxs, Prof p, int x0, bool fromRight, color pocCol) =>
    if not na(p) and not na(p.kLo)
        [poc, vah, val] = f_profile(p.vol, p.kLo, p.kHi, vpRow, vpVA)
        span  = p.kHi - p.kLo + 1
        grp   = math.max(1, int(math.ceil(span / histRows)))
        nRows = int(math.ceil(span / grp))
        sums  = array.new<float>(nRows, 0.0)
        for k = p.kLo to p.kHi
            g = int((k - p.kLo) / grp)
            sums.set(g, sums.get(g) + nz(p.vol.get(k)))
        mx = sums.max()
        maxW = fromRight ? histBars * timeframe.in_seconds() * 1000.0 : 86400000.0 * histWidth / 100.0
        if mx > 0
            for g = 0 to nRows - 1
                v = sums.get(g)
                if v > 0
                    bot = (p.kLo + g * grp) * vpRow
                    top = (p.kLo + (g + 1) * grp) * vpRow
                    ctr = (bot + top) / 2
                    col = (poc >= bot and poc < top) ? pocCol : (ctr >= val and ctr <= vah) ? histVA : histOut
                    w = int(maxW * v / mx)
                    bxs.push(box.new(left = fromRight ? x0 - w : x0, top = top, right = fromRight ? x0 : x0 + w, bottom = bot, xloc = xloc.bar_time, border_color = color.new(color.black, 100), border_width = 0, bgcolor = col))

// הפרופיל בצד ימין יושב בשטח הריק שאחרי הנר האחרון: הקצה הימני שלו histOffset נרות מהנר האחרון
// והפסים גדלים שמאלה (לכיוון הנרות), כך שהתוויות נשארות בין הנרות לפרופיל
histRightX = time + histOffset * timeframe.in_seconds() * 1000

var box[] bxs = array.new<box>()
if barstate.islast
    for b in bxs
        box.delete(b)
    bxs.clear()
    // פרופיל בצד ימין (ברירת מחדל: של היום, מתעדכן), צמוד לימין ליד המחיר הנוכחי
    if sideProf == "היום (מתעדכן)" and not na(drawCur)
        f_hist(bxs, drawCur, histRightX, true, histPOCtd)
    if sideProf == "אתמול" and not na(drawPrev)
        f_hist(bxs, drawPrev, histRightX, true, histPOC)
    // אופציונלי: כל פרופיל גם על האזור של היום שלו בגרף
    if showHistPD and not na(drawPrev)
        f_hist(bxs, drawPrev, drawPrev.start, false, histPOC)
    if showHistCD and not na(drawCur)
        f_hist(bxs, drawCur, drawCur.start, false, histPOCtd)

// ───────────── קופסאות סשנים: אסיה / לונדון / ניו יורק ─────────────
// אסיה ולונדון = אותם חלונות של קווי Asia / London High-Low; ניו יורק = 09:30-16:00. הכל בשעון ניו יורק,
// מנרות של דקה - לכן הגבוה/נמוך זהים בכל טווח זמן של הגרף. כל קופסה = מתחילת החלון עד סופו, מהגבוה עד הנמוך שלו
type Sess
    int   start
    int   end
    float hi
    float lo
    int   key

// מוסיף נר דקה לסשן: אם הוא בתוך שעות הסשן - מעדכן את הסשן של אותו יום (או פותח חדש)
// המפתח הוא יום המסחר (מ-18:00 ניו יורק), כך שחלון שעובר חצות נשאר קופסה אחת
f_feed(Sess[] arr, int t, int dur, float h, float l, int sMin, int eMin, int keep) =>
    if f_inWin(hour(t, TZ) * 60 + minute(t, TZ), sMin, eMin)
        k = f_dayKey(t, dsMin)
        Sess cur = arr.size() > 0 ? arr.last() : na
        // שני הענפים מחזירים 0 - Pine דורש שלכל ענפי if/else יהיה אותו סוג ערך
        if na(cur) or cur.key != k
            arr.push(Sess.new(t, t + dur, h, l, k))
            if arr.size() > keep
                arr.shift()
            0
        else
            cur.end := t + dur
            cur.hi  := math.max(cur.hi, h)
            cur.lo  := math.min(cur.lo, l)
            0
    true

f_cloneTail(Sess[] arr) =>
    Sess[] c = arr.copy()
    if c.size() > 0
        c.set(c.size() - 1, c.last().copy())
    c

f_feedAll(Sess[] tok, Sess[] ldn, Sess[] ny, array<int> ts, array<float> hs, array<float> ls, int dur) =>
    [nS, nE] = f_parse(nySess)
    n = ts.size()
    if n > 0
        for i = 0 to n - 1
            t = ts.get(i)
            f_feed(tok, t, dur, hs.get(i), ls.get(i), aS, aE, sessDays)
            f_feed(ldn, t, dur, hs.get(i), ls.get(i), lS, lE, sessDays)
            f_feed(ny, t, dur, hs.get(i), ls.get(i), nS, nE, sessDays)

var Sess[] tokArr = array.new<Sess>()
var Sess[] ldnArr = array.new<Sess>()
var Sess[] nyArr  = array.new<Sess>()
ltDur = timeframe.in_seconds(ltf) * 1000

// כמו בפרופיל: מצב קבוע מתעדכן רק בנרות סגורים; לנר החי עובדים על עותק של הסשן האחרון
Sess[] drawTok = tokArr
Sess[] drawLdn = ldnArr
Sess[] drawNy  = nyArr
if showSess
    if barstate.isconfirmed
        f_feedAll(tokArr, ldnArr, nyArr, ltT, ltH, ltL, ltDur)
    else if barstate.islast
        drawTok := f_cloneTail(tokArr)
        drawLdn := f_cloneTail(ldnArr)
        drawNy  := f_cloneTail(nyArr)
        f_feedAll(drawTok, drawLdn, drawNy, ltT, ltH, ltL, ltDur)

f_drawSess(box[] sb, label[] sl, Sess[] arr, string name, color c) =>
    for s in arr
        sb.push(box.new(left = s.start, top = s.hi, right = s.end, bottom = s.lo, xloc = xloc.bar_time, border_color = c, border_width = 1, border_style = line.style_dashed, bgcolor = color.new(c, sessAlpha)))
        txt = sessNums ? name + "\nH " + str.tostring(s.hi, "0.00#") + " · L " + str.tostring(s.lo, "0.00#") + " · " + str.tostring(s.hi - s.lo, "0.##") + " נק׳" : name
        sl.push(label.new(x = int((s.start + s.end) / 2), y = s.hi, text = txt, xloc = xloc.bar_time, yloc = yloc.price, color = color.new(color.black, 100), style = label.style_label_down, textcolor = c, size = size.small))

var box[]   sessBoxes  = array.new<box>()
var label[] sessLabels = array.new<label>()
if barstate.islast
    for b in sessBoxes
        box.delete(b)
    for lb in sessLabels
        label.delete(lb)
    sessBoxes.clear()
    sessLabels.clear()
    if showSess
        if showTok
            f_drawSess(sessBoxes, sessLabels, drawTok, "Asia", tokColor)
        if showLdn
            f_drawSess(sessBoxes, sessLabels, drawLdn, "London", ldnColor)
        if showNy
            f_drawSess(sessBoxes, sessLabels, drawNy, "New York", nyColor)

// ───────────── ציור (רק על הנר האחרון = יום המסחר הנוכחי) ─────────────
// הקו מצויר מיד; התווית נאספת לרשימה, וכל התוויות מסודרות בסוף כך שלא יעלו אחת על השנייה
f_draw(line[] lns, label[] lbs, float[] lp, string[] lt, color[] lc, int x1, float y, color c, int w, string st, string name, bool full) =>
    if not na(y) and not na(x1)
        lns.push(line.new(x1, y, x1 + 60000, y, xloc.bar_time, extend.right, c, f_style(st), w))
        if showLabels
            lp.push(y)
            lt.push(name + "  " + str.tostring(y, "0.00#") + (full ? "" : " (partial)"))
            lc.push(c)
        if showTags
            // שם הקו כתוב מעל הקו, בנקודה שבה הוא מתחיל
            lbs.push(label.new(x1, y, name, xloc.bar_time, yloc.price, color.new(color.white, 100), label.style_label_lower_left, c, size.small))

// Today POC / VAH / VAL - מהפרופיל המתפתח של היום (מהנמוך עד הגבוה של היום, נכון לעכשיו)
float todPoc = na
float todVah = na
float todVal = na
if showTD and barstate.islast and not na(drawCur) and not na(drawCur.kLo)
    [tp, th, tl] = f_profile(drawCur.vol, drawCur.kLo, drawCur.kHi, vpRow, vpVA)
    todPoc := tp
    todVah := th
    todVal := tl

var line[]  lns = array.new<line>()
var label[] lbs = array.new<label>()

if barstate.islast
    // מוחקים את הציור הקודם (כולל קווי היום הקודם) ומציירים מחדש לפי המצב הנוכחי
    for ln in lns
        line.delete(ln)
    for lb in lbs
        label.delete(lb)
    lns.clear()
    lbs.clear()

    sz = switch labelSize
        "Small" => size.small
        "Large" => size.large
        => size.normal
    lblX = time + labelOffset * timeframe.in_seconds() * 1000
    // חלון נחשב שלם אם התחיל אחרי תחילת הנתונים שנטענו
    aFull = dFull or aT > dT
    lFull = dFull or lT > dT
    lp = array.new<float>()
    lt = array.new<string>()
    lc = array.new<color>()

    if showPD
        f_draw(lns, lbs, lp, lt, lc, dT, pdHi, pdColor, pdWidth, pdStyle, "Previous Day High", pdFull)
        f_draw(lns, lbs, lp, lt, lc, dT, pdLo, pdColor, pdWidth, pdStyle, "Previous Day Low", pdFull)
    if showVP
        f_draw(lns, lbs, lp, lt, lc, dT, pPoc, pocColor, pocWidth, pocStyle, "PD POC", pdFull)
        if showPdVa
            f_draw(lns, lbs, lp, lt, lc, dT, pVah, vaColor, vaWidth, vaStyle, "PD VAH", pdFull)
            f_draw(lns, lbs, lp, lt, lc, dT, pVal, vaColor, vaWidth, vaStyle, "PD VAL", pdFull)
    if showTD
        f_draw(lns, lbs, lp, lt, lc, dT, todPoc, tdPocCol, tdPocW, tdPocSt, "Today POC", dFull)
        f_draw(lns, lbs, lp, lt, lc, dT, todVah, tdVaCol, tdVaW, tdVaSt, "Today VAH", dFull)
        f_draw(lns, lbs, lp, lt, lc, dT, todVal, tdVaCol, tdVaW, tdVaSt, "Today VAL", dFull)
    if showMid
        f_draw(lns, lbs, lp, lt, lc, dT, mid, midColor, midWidth, midStyle, "50% Daily Range", dFull)
    if showAsia
        f_draw(lns, lbs, lp, lt, lc, aT, aHi, asiaColor, asiaWidth, asiaStyle, "Asia High", aFull)
        f_draw(lns, lbs, lp, lt, lc, aT, aLo, asiaColor, asiaWidth, asiaStyle, "Asia Low", aFull)
    if showLon
        f_draw(lns, lbs, lp, lt, lc, lT, lHi, lonColor, lonWidth, lonStyle, "London High", lFull)
        f_draw(lns, lbs, lp, lt, lc, lT, lLo, lonColor, lonWidth, lonStyle, "London Low", lFull)

    // מסדרים את התוויות מהגבוהה לנמוכה; תווית שקרובה מדי לזו שמעליה מוזזת קצת למטה
    n = lp.size()
    if n > 0
        idx = lp.sort_indices(order.descending)
        float lastY = na
        for i = 0 to n - 1
            j = idx.get(i)
            y = lp.get(j)
            if not na(lastY) and lastY - y < lblGap
                y := lastY - lblGap
            lastY := y
            lbs.push(label.new(lblX, y, lt.get(j), xloc.bar_time, yloc.price, lc.get(j), label.style_label_left, labelText, sz))

// סימון המחירים על סקאלת המחירים (ערך אחרון בלבד)
plot(showMid  and barstate.islast ? mid : na, "50% Daily Range", midColor,  display = showScale ? display.price_scale : display.none)
plot(showAsia and barstate.islast ? aHi : na, "Asia High",       asiaColor, display = showScale ? display.price_scale : display.none)
plot(showAsia and barstate.islast ? aLo : na, "Asia Low",        asiaColor, display = showScale ? display.price_scale : display.none)
plot(showLon  and barstate.islast ? lHi : na, "London High",     lonColor,  display = showScale ? display.price_scale : display.none)
plot(showLon  and barstate.islast ? lLo : na, "London Low",      lonColor,  display = showScale ? display.price_scale : display.none)
plot(showPD   and barstate.islast ? pdHi : na, "Previous Day High", pdColor, display = showScale ? display.price_scale : display.none)
plot(showPD   and barstate.islast ? pdLo : na, "Previous Day Low",  pdColor, display = showScale ? display.price_scale : display.none)
plot(showVP   and barstate.islast ? pPoc : na, "PD POC", pocColor, display = showScale ? display.price_scale : display.none)
plot(showPdVa and barstate.islast ? pVah : na, "PD VAH", vaColor,  display = showScale ? display.price_scale : display.none)
plot(showPdVa and barstate.islast ? pVal : na, "PD VAL", vaColor,  display = showScale ? display.price_scale : display.none)
plot(showTD   and barstate.islast ? todPoc : na, "Today POC", tdPocCol, display = showScale ? display.price_scale : display.none)
plot(showTD   and barstate.islast ? todVah : na, "Today VAH", tdVaCol,  display = showScale ? display.price_scale : display.none)
plot(showTD   and barstate.islast ? todVal : na, "Today VAL", tdVaCol,  display = showScale ? display.price_scale : display.none)

// ───────────── טבלת כמות חוזים לפי סיכון קבוע ─────────────
// לכל קו מוצג מעל/מתחת למחיר: סטופ = הקו + מרווח, וכמות החוזים כך שההפסד בסטופ <= riskUsd.
// סדר השורות כמו בגרף: קווי שורט (מעל המחיר) למעלה, המחיר הנוכחי באמצע, קווי לונג (מתחת) למטה.
f_pos(string s) =>
    switch s
        "למעלה משמאל" => position.top_left
        "למעלה מימין" => position.top_right
        "באמצע משמאל" => position.middle_left
        "באמצע מימין" => position.middle_right
        "למטה מימין"  => position.bottom_right
        => position.bottom_left

f_lvl(string[] names, float[] prices, color[] cols, string name, float y, color c) =>
    if not na(y)
        names.push(name)
        prices.push(y)
        cols.push(c)

const int R_COLS = 6
riskRowsTotal = riskRows * 2 + 3
var table riskTbl = na

f_riskRow(table t, int r, bool isShort, string name, color c, float lvl, float px, string sz) =>
    pv   = syminfo.pointvalue
    stop = math.round_to_mintick(isShort ? lvl + stopBuf : lvl - stopBuf)
    dist = math.abs(stop - px)
    per  = dist * pv + riskFee
    n    = per > 0 ? int(math.floor(riskUsd / per + 1e-9)) : 0
    loss = n * per
    t.cell(0, r, isShort ? "שורט" : "לונג", text_color = isShort ? #F23645 : #089981, text_size = sz)
    t.cell(1, r, name, text_color = c, text_size = sz, text_halign = text.align_left)
    t.cell(2, r, str.tostring(stop, format.mintick), text_color = #D1D4DC, text_size = sz)
    t.cell(3, r, str.tostring(dist, "0.##"), text_color = #D1D4DC, text_size = sz)
    t.cell(4, r, str.tostring(n), text_color = n > 0 ? color.white : #F23645, bgcolor = n > 0 ? color.new(#2962FF, 40) : color.new(#F23645, 80), text_size = sz, tooltip = n > 0 ? "" : "הסטופ רחוק מדי - גם חוזה אחד עובר את הסיכון שהוגדר")
    t.cell(5, r, "$" + str.tostring(loss, "#,##0"), text_color = #D1D4DC, text_size = sz)

if barstate.islast
    // בונים את הטבלה מחדש בכל עדכון (כולל מיזוג התאים) במקום לנקות טבלה קיימת
    if not na(riskTbl)
        riskTbl.delete()
    riskTbl := na
    if showRisk
        riskTbl := table.new(f_pos(riskPos), R_COLS, riskRowsTotal, bgcolor = color.new(#131722, 5), frame_color = #434651, frame_width = 1, border_color = #2A2E39, border_width = 1)
        rsz = switch riskSize
            "Small" => size.small
            "Large" => size.large
            => size.normal
        rn = array.new<string>()
        rp = array.new<float>()
        rc = array.new<color>()
        if showPD
            f_lvl(rn, rp, rc, "PD High", pdHi, pdColor)
            f_lvl(rn, rp, rc, "PD Low", pdLo, pdColor)
        if showVP
            f_lvl(rn, rp, rc, "PD POC", pPoc, pocColor)
            if showPdVa
                f_lvl(rn, rp, rc, "PD VAH", pVah, vaColor)
                f_lvl(rn, rp, rc, "PD VAL", pVal, vaColor)
        if showTD
            f_lvl(rn, rp, rc, "Today POC", todPoc, tdPocCol)
            f_lvl(rn, rp, rc, "Today VAH", todVah, tdVaCol)
            f_lvl(rn, rp, rc, "Today VAL", todVal, tdVaCol)
        if showMid
            f_lvl(rn, rp, rc, "50% Daily", mid, midColor)
        if showAsia
            f_lvl(rn, rp, rc, "Asia High", aHi, asiaColor)
            f_lvl(rn, rp, rc, "Asia Low", aLo, asiaColor)
        if showLon
            f_lvl(rn, rp, rc, "London High", lHi, lonColor)
            f_lvl(rn, rp, rc, "London Low", lLo, lonColor)

        px = close
        // הקווים הקרובים ביותר מכל צד: above = מעל המחיר (מהקרוב לרחוק), below = מתחת למחיר (מהקרוב לרחוק)
        above = array.new<int>()
        below = array.new<int>()
        nL = rp.size()
        if nL > 0
            idx = rp.sort_indices(order.ascending)
            for i = 0 to nL - 1
                j = idx.get(i)
                if rp.get(j) > px and above.size() < riskRows
                    above.push(j)
            for i = nL - 1 to 0
                j = idx.get(i)
                if rp.get(j) < px and below.size() < riskRows
                    below.push(j)

        riskTbl.cell(0, 0, "סיכון $" + str.tostring(riskUsd, "#,##0") + " · סטופ " + str.tostring(stopBuf, "0.##") + " נק׳ מעבר לקו · " + syminfo.ticker, text_color = color.white, text_size = rsz)
        riskTbl.merge_cells(0, 0, R_COLS - 1, 0)
        hdr = array.from("", "קו", "סטופ", "נק׳", "חוזים", "הפסד")
        for c = 0 to R_COLS - 1
            riskTbl.cell(c, 1, hdr.get(c), text_color = #787B86, text_size = rsz)

        int r = 2
        // שורט: מהרחוק (למעלה) לקרוב (צמוד למחיר), כמו בגרף
        nA = above.size()
        if nA > 0
            for i = nA - 1 to 0
                j = above.get(i)
                f_riskRow(riskTbl, r, true, rn.get(j), rc.get(j), rp.get(j), px, rsz)
                r += 1
        riskTbl.cell(0, r, "מחיר", text_color = color.white, text_size = rsz)
        riskTbl.cell(1, r, str.tostring(px, format.mintick), text_color = color.white, text_size = rsz)
        riskTbl.merge_cells(1, r, R_COLS - 1, r)
        r += 1
        for j in below
            f_riskRow(riskTbl, r, false, rn.get(j), rc.get(j), rp.get(j), px, rsz)
            r += 1

// ───────────── התראות ─────────────
// בודקים בכל טיק אם המחיר חצה/נגע בקו מאז הטיק הקודם. varip שומר ערכים בין טיקים.
// אסיה/לונדון מתריעים רק אחרי שהחלון נסגר (כשהקו כבר קבוע).
varip float lastPx  = na
varip int   alertDay = na
varip bool  hitAH = false
varip bool  hitAL = false
varip bool  hitLH = false
varip bool  hitLL = false
varip bool  hitM  = false
varip bool  hitPH = false
varip bool  hitPL = false
varip bool  hitPOC = false
varip bool  hitVAH = false
varip bool  hitVAL = false
// זמן ההתראה האחרונה של כל קו (להשהיה של alertCool דקות)
varip int   tmAH = na
varip int   tmAL = na
varip int   tmLH = na
varip int   tmLL = na
varip int   tmM  = na
varip int   tmPH = na
varip int   tmPL = na
varip int   tmPOC = na
varip int   tmVAH = na
varip int   tmVAL = na

f_touched(float prev, float px, float lvl) =>
    not na(prev) and not na(lvl) and ((prev < lvl and px >= lvl) or (prev > lvl and px <= lvl) or px == lvl)

// hit = הקו "לא טעון" (כבר התריע / רק נוצר). נטען מחדש כשהמחיר מתרחק ממנו alertRearm נקודות.
// בנוסף, אחרי התראה הקו שותק alertCool דקות. מחזיר [האם להתריע עכשיו, מצב hit חדש, זמן התראה אחרונה]
f_check(float prev, float px, float lvl, bool hit, int lastT) =>
    bool fire = false
    bool h = hit
    int  tm = lastT
    if not na(lvl)
        if h and math.abs(px - lvl) >= alertRearm
            h := false
        cooled = na(tm) or timenow - tm >= alertCool * 60000
        if not h and cooled and f_touched(prev, px, lvl)
            h := true
            fire := true
            tm := timenow
    [fire, h, tm]

f_msg(string name, float lvl) =>
    syminfo.ticker + ": המחיר הגיע ל-" + name + " " + str.tostring(lvl, "0.00#")

// אירועי נגיעה בטיק הנוכחי (מתאפסים בכל ריצה)
bool tAH = false
bool tAL = false
bool tLH = false
bool tLL = false
bool tM  = false
bool tPH = false
bool tPL = false
bool tPOC = false
bool tVAH = false
bool tVAL = false

if barstate.isrealtime
    // ביום חדש כל הקווים מתחילים "לא טעונים": קו מתריע רק אחרי שהמחיר התרחק ממנו alertRearm נקודות
    if na(alertDay) or alertDay != dT
        alertDay := dT
        hitAH := true
        hitAL := true
        hitLH := true
        hitLL := true
        hitM  := true
        hitPH := true
        hitPL := true
        hitPOC := true
        hitVAH := true
        hitVAL := true

    // אסיה/לונדון נבדקים רק אחרי שהחלון נסגר (כשהקו כבר קבוע)
    if alertAsia and aDone
        [f1, h1, m1] = f_check(lastPx, close, aHi, hitAH, tmAH)
        [f2, h2, m2] = f_check(lastPx, close, aLo, hitAL, tmAL)
        tAH := f1
        hitAH := h1
        tmAH := m1
        tAL := f2
        hitAL := h2
        tmAL := m2
    if alertLon and lDone
        [f1, h1, m1] = f_check(lastPx, close, lHi, hitLH, tmLH)
        [f2, h2, m2] = f_check(lastPx, close, lLo, hitLL, tmLL)
        tLH := f1
        hitLH := h1
        tmLH := m1
        tLL := f2
        hitLL := h2
        tmLL := m2
    if alertMid
        [f1, h1, m1] = f_check(lastPx, close, mid, hitM, tmM)
        tM := f1
        hitM := h1
        tmM := m1
    if alertPD
        [f1, h1, m1] = f_check(lastPx, close, pdHi, hitPH, tmPH)
        [f2, h2, m2] = f_check(lastPx, close, pdLo, hitPL, tmPL)
        tPH := f1
        hitPH := h1
        tmPH := m1
        tPL := f2
        hitPL := h2
        tmPL := m2
    if alertVP
        [f1, h1, m1] = f_check(lastPx, close, pPoc, hitPOC, tmPOC)
        [f2, h2, m2] = f_check(lastPx, close, pVah, hitVAH, tmVAH)
        [f3, h3, m3] = f_check(lastPx, close, pVal, hitVAL, tmVAL)
        tPOC := f1
        hitPOC := h1
        tmPOC := m1
        tVAH := f2
        hitVAH := h2
        tmVAH := m2
        tVAL := f3
        hitVAL := h3
        tmVAL := m3

    lastPx := close

if tAH
    alert(f_msg("Asia High", aHi), alert.freq_all)
if tAL
    alert(f_msg("Asia Low", aLo), alert.freq_all)
if tLH
    alert(f_msg("London High", lHi), alert.freq_all)
if tLL
    alert(f_msg("London Low", lLo), alert.freq_all)
if tM
    alert(f_msg("50% Daily Range", mid), alert.freq_all)
if tPH
    alert(f_msg("Previous Day High", pdHi), alert.freq_all)
if tPL
    alert(f_msg("Previous Day Low", pdLo), alert.freq_all)
if tPOC
    alert(f_msg("PD POC", pPoc), alert.freq_all)
if tVAH
    alert(f_msg("PD VAH", pVah), alert.freq_all)
if tVAL
    alert(f_msg("PD VAL", pVal), alert.freq_all)

// התראות עם שם, שמופיעות ברשימת "תנאי" בחלון יצירת ההתראה
alertcondition(tAH or tAL or tLH or tLL or tM or tPH or tPL or tPOC or tVAH or tVAL, "NQ Levels - נגיעה בקו", "{{ticker}}: המחיר הגיע לאחד הקווים (אסיה / לונדון / 50% / יום קודם). מחיר: {{close}}")
alertcondition(tAH, "Asia High - נגיעה", "{{ticker}}: המחיר הגיע ל-Asia High. מחיר: {{close}}")
alertcondition(tAL, "Asia Low - נגיעה", "{{ticker}}: המחיר הגיע ל-Asia Low. מחיר: {{close}}")
alertcondition(tLH, "London High - נגיעה", "{{ticker}}: המחיר הגיע ל-London High. מחיר: {{close}}")
alertcondition(tLL, "London Low - נגיעה", "{{ticker}}: המחיר הגיע ל-London Low. מחיר: {{close}}")
