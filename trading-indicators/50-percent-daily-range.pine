// 50% Daily Range - NQ / MNQ
//
// יום מסחר = מ-18:00 שעון ניו יורק (ערב קודם) ועד 17:00 שעון ניו יורק.
// הגבוה/נמוך נלקחים מהנר היומי של הבורסה (CME Globex), שב-TradingView מתחיל בדיוק
// ב-18:00 America/New_York כולל מעבר אוטומטי בין שעון קיץ/חורף. לכן:
//   * החישוב כולל את כל המסחר מתחילת היום (כולל לילה ופתילים), גם מה שמחוץ לחלון הגרף.
//   * הקו יוצא באותו מחיר בדיוק בכל טווח זמן (1 שניה, 1 דקה, 5 דקות, שעה...) של אותו חוזה.
//   * בפתיחת יום מסחר חדש (18:00) החישוב מתחיל מחדש אוטומטית.

//@version=6
indicator("50% Daily Range", shorttitle = "50% DR", overlay = true, max_lines_count = 1, max_labels_count = 1)

// ───────────── הגדרות ─────────────
lineColor   = input.color(#FFD600, "צבע הקו", group = "קו")
lineWidth   = input.int(2, "עובי הקו", minval = 1, maxval = 10, group = "קו")
styleOpt    = input.string("Dashed", "סגנון הקו", options = ["Solid", "Dashed", "Dotted"], group = "קו")

showLabel   = input.bool(true, "הצג תווית", group = "תווית")
labelOffset = input.int(8, "מרחק התווית מהנר האחרון (בנרות)", minval = 0, maxval = 400, group = "תווית")
labelText   = input.color(color.black, "צבע טקסט התווית", group = "תווית")
labelSize   = input.string("Normal", "גודל התווית", options = ["Small", "Normal", "Large"], group = "תווית")

showScale   = input.bool(true, "הצג את המחיר על סקאלת המחירים", group = "תווית")

// ───────────── בדיקות ─────────────
if timeframe.isweekly or timeframe.ismonthly
    runtime.error("50% Daily Range עובד בטווחי זמן של יום ומטה (שניות / דקות / שעות / יומי).")

lineStyle = switch styleOpt
    "Solid"  => line.style_solid
    "Dotted" => line.style_dotted
    => line.style_dashed

lblSize = switch labelSize
    "Small" => size.small
    "Large" => size.large
    => size.normal

// ───────────── חישוב ─────────────
// גבוה ונמוך של יום המסחר הנוכחי (מ-18:00 ניו יורק ועד עכשיו), מתעדכן בכל טיק.
// lookahead_on נדרש כדי לקבל את היום *המתפתח* ולא את היום הקודם. הערך משמש רק בנר
// האחרון (היום הנוכחי), כך שאין כאן "הצצה לעתיד".
[dayHigh, dayLow] = request.security(syminfo.tickerid, "D", [high, low], lookahead = barmerge.lookahead_on)
mid = (dayHigh + dayLow) / 2

// ───────────── ציור ─────────────
var line  midLine  = na
var label midLabel = na

if barstate.islast and not na(mid)
    if na(midLine)
        midLine := line.new(x1 = bar_index - 1, y1 = mid, x2 = bar_index, y2 = mid, xloc = xloc.bar_index, extend = extend.both, color = lineColor, style = lineStyle, width = lineWidth)
    else
        line.set_xy1(midLine, bar_index - 1, mid)
        line.set_xy2(midLine, bar_index, mid)

    if showLabel
        txt = "50% Daily Range  " + str.tostring(mid, "0.00#")
        if na(midLabel)
            midLabel := label.new(x = bar_index + labelOffset, y = mid, text = txt, xloc = xloc.bar_index, yloc = yloc.price, color = lineColor, style = label.style_label_left, textcolor = labelText, size = lblSize)
        else
            label.set_xy(midLabel, bar_index + labelOffset, mid)
            label.set_text(midLabel, txt)

// סימון המחיר על סקאלת המחירים (הערך האחרון בלבד)
plot(barstate.islast ? mid : na, "50% Daily Range", lineColor, display = showScale ? display.price_scale : display.none)
